# 第5週で Supabase につなぐときに使います。
# このファイルをコピーして .env.local という名前のファイルを作り、= の右に値を貼り付けます。
# .env.local は GitHub に送られません（コミットされません）。
# Vercel では「Settings → Environment Variables」に同じ名前で登録します。

# Supabase の Project URL（https://xxxx.supabase.co の形）
NEXT_PUBLIC_SUPABASE_URL=
# Supabase の anon キー、または publishable キー（sb_publishable_ で始まる）
# service_role キーや secret キー（sb_secret_ で始まる）は絶対に入れない
NEXT_PUBLIC_SUPABASE_ANON_KEY=
